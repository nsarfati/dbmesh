FROM golang:1.23-bookworm AS build

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN go build -o /out/dbmesh ./cmd/dbmesh

FROM python:3.14-slim AS runtime

ENV DBMESH_CONFIG=/app/config_proxy.yaml

WORKDIR /app
RUN pip install --no-cache-dir awscli \
    && useradd --create-home --uid 10001 dbmesh \
    && chown dbmesh:dbmesh /app
COPY --from=build /out/dbmesh /usr/local/bin/dbmesh

USER dbmesh
EXPOSE 6432

# Supply config.yaml at runtime; never bake database credentials into the image.
# When AWS_ENDPOINT_URL is set, config_proxy.yaml is fetched from the Railway bucket first.
CMD ["sh", "-c", "if [ -n \"$AWS_ENDPOINT_URL\" ]; then aws --endpoint-url \"$AWS_ENDPOINT_URL\" s3 cp \"s3://$AWS_S3_BUCKET_NAME/${BUCKET_CONFIG_KEY:-config_proxy.yaml}\" \"$DBMESH_CONFIG\"; fi; exec dbmesh -config \"$DBMESH_CONFIG\""]
